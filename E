  });
  window.addEventListener('focus', rematar);

  document.getElementById('copyModal').addEventListener('click', function(){
    copiar(this, function(){
      copiado = true;
      listoEn = Date.now() + ESPERA;
      paso1.hidden = true;
      paso2.hidden = false;
      if (navigator.vibrate){ try{ navigator.vibrate([20,50,20]); }catch(e){} }
      timers.push(setTimeout(rematar, ESPERA + 400));
    });
  });

  document.getElementById('copyAgain').addEventListener('click', function(){
    copiar(this);
  });

  document.getElementById('mClose').addEventListener('click', cerrarModal);
  document.getElementById('veil').addEventListener('click', cerrarModal);

  document.getElementById('copyLink').addEventListener('click', function(){
    copiar(this);
  });

  document.getElementById('again').addEventListener('click', function(){
    clearTimers();
    copiado = false;
    listoEn = 0;
    foot.hidden = true;
    show(1);
    window.scrollTo(0,0);
  });

  document.getElementById('sendBtn').addEventListener('click', async function(){
    var url = location.href;
    if (navigator.share){
      try{ await navigator.share({ title:'Reward event', url:url }); return; }catch(e){ return; }
    }
    try{ await navigator.clipboard.writeText(url); this.textContent = 'Link copied'; }
    catch(e){ this.textContent = 'Copie o link da address bar'; }
  });
})();
</script>
</body>
</html>
