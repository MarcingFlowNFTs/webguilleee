<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Evento · Recompensa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0f1114;
    --card:#ffffff;
    --ink:#14161a;
    --ink-dim:#6b7280;
    --line:#e6e8ec;
    --purple:#5b2fe0;
    --purple-hi:#7c4dff;
    --blue:#1a56db;
    --green:#00a35f;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{
    background:radial-gradient(120% 60% at 50% 0%, #2a1a52 0%, rgba(15,17,20,0) 55%), var(--bg);
    font-family:"Montserrat",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    min-height:100vh;min-height:100dvh;
    display:flex;align-items:center;justify-content:center;
    padding:calc(20px + env(safe-area-inset-top)) 14px calc(20px + env(safe-area-inset-bottom));
  }

  .shell{width:100%;max-width:420px}

  .card{
    background:var(--card);color:var(--ink);
    border-radius:22px;overflow:hidden;
    box-shadow:0 24px 60px rgba(0,0,0,.55);
  }

  /* ---------- Banner del evento ---------- */
  /* ---------- Inventario (pantalla principal) ---------- */
  .inv{padding:14px 13px 16px}
  .inv-head{display:flex;align-items:center;gap:8px;margin-bottom:3px}
  .inv-head h1{flex:1;font-size:20px;font-weight:900;letter-spacing:-.7px;margin:0;color:var(--ink)}
  .inv-filter{
    display:flex;align-items:center;gap:5px;cursor:pointer;
    background:#fff;border:1px solid #cfd3d9;border-radius:10px;padding:6px 10px;
    font-family:inherit;font-size:12px;font-weight:700;color:var(--ink);
  }
  .inv-sub{font-size:11.5px;font-weight:600;color:var(--ink-dim);line-height:1.35;margin:0 0 10px}

  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px 7px;margin-bottom:12px}
  .item{margin:0;min-width:0}
  .item{position:relative;cursor:pointer;border-radius:12px;padding:4px;transition:transform .1s ease,box-shadow .15s ease,background .15s ease;border:2px solid transparent}
  .item:active{transform:scale(.96)}
  .item.selected{background:#f3efff;border-color:#7c4dff;box-shadow:0 4px 14px rgba(124,77,255,.35)}
  .item .tick{position:absolute;top:2px;right:2px;width:22px;height:22px;border-radius:50%;background:#7c4dff;color:#fff;display:none;align-items:center;justify-content:center;font-size:14px;font-weight:900;box-shadow:0 2px 6px rgba(0,0,0,.3);z-index:2}
  .item.selected .tick{display:flex}

  .item img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px;display:block;background:#c9ccd4}
  .item figcaption{
    font-size:9.5px;font-weight:700;line-height:1.2;color:var(--ink);
    margin:5px 0 2px;min-height:23px;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  .item .price{display:flex;align-items:center;gap:3px;font-size:9.5px;font-weight:700;color:#5e6167}
  .item .price svg{width:11px;height:11px;flex:0 0 11px}

  .inv-total{
    display:flex;align-items:center;justify-content:space-between;
    border-top:1px solid var(--line);padding-top:11px;margin-bottom:11px;
    font-size:13px;font-weight:700;color:var(--ink-dim);
  }
  .inv-total b{display:flex;align-items:center;gap:5px;font-size:16px;font-weight:900;color:var(--ink);letter-spacing:-.4px}
  #go{font-size:16px;padding:14px}
  .inv .safe{margin-top:10px;font-size:11.5px}

  .banner{
    position:relative;
    background:linear-gradient(120deg,#3b1d7a 0%,#5b2fe0 55%,#1e2a8a 100%);
    padding:20px 18px 22px;
    overflow:hidden;
  }
  .tag{
    display:inline-flex;align-items:center;gap:6px;
    background:rgba(255,255,255,.16);
    border:1px solid rgba(255,255,255,.28);
    color:#fff;font-size:11px;font-weight:800;letter-spacing:1.6px;
    padding:6px 12px;border-radius:999px;text-transform:uppercase;
  }
  .banner h1{
    color:#fff;font-size:30px;font-weight:900;line-height:1;
    margin:16px 0 4px;letter-spacing:-1px;font-style:italic;
    text-shadow:0 4px 14px rgba(0,0,0,.35);
  }
  .banner .kicker{
    color:#c9b6ff;font-size:12px;font-weight:800;letter-spacing:5px;margin:0;
  }
  .banner .glow{
    position:absolute;right:-30px;top:-20px;width:180px;height:180px;
    background:radial-gradient(circle,#00e0ff33 0%,transparent 65%);
  }
  .dot{position:absolute;border-radius:50%;opacity:.85}

  /* ---------- Cuerpo ---------- */
  .body{padding:20px 18px 22px}
  .who{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .avatar{
    width:38px;height:38px;border-radius:12px;
    background:#14161a;display:flex;align-items:center;justify-content:center;
  }
  .who b{font-size:15px;display:block;line-height:1.2}
  .who span{font-size:12.5px;color:var(--ink-dim);font-weight:600}

  h2{font-size:21px;font-weight:800;margin:0 0 6px;letter-spacing:-.4px}
  .desc{font-size:14.5px;color:var(--ink-dim);font-weight:600;line-height:1.5;margin:0 0 18px}

  .prize{
    display:flex;align-items:center;gap:12px;
    background:#f3efff;border:1px solid #e2d9ff;
    border-radius:14px;padding:12px 14px;margin-bottom:16px;
  }
  .prize .amount{font-size:19px;font-weight:900;color:var(--purple);line-height:1.1}
  .prize .lbl{font-size:12px;font-weight:700;color:#7a6bb0}

  .btn{
    width:100%;border:0;border-radius:14px;
    font-family:inherit;font-size:17px;font-weight:800;color:#fff;
    padding:16px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:9px;
    transition:transform .08s ease, filter .2s ease;
  }
  .btn:active{transform:translateY(2px)}
  .btn:focus-visible{outline:3px solid var(--purple-hi);outline-offset:3px}
  .btn-primary{background:var(--blue);box-shadow:0 5px 0 #143f9e}
  .btn-purple{background:var(--purple);box-shadow:0 5px 0 #3d1ba3}
  .btn-ghost{background:#f2f3f5;color:var(--ink);box-shadow:0 5px 0 #dcdee2;font-size:15px}

  .safe{
    display:flex;align-items:center;justify-content:center;gap:8px;
    margin-top:14px;font-size:12.5px;font-weight:700;color:var(--green);
  }

  /* ---------- Pantalla de carga ---------- */
  .stage{display:none}
  .stage.on{display:block}

  .loader{text-align:center;padding:6px 0 2px}

  .status{font-size:14px;font-weight:700;color:var(--ink-dim);min-height:21px}

  .count{font-size:74px;font-weight:900;color:var(--purple);line-height:1;margin:14px 0 6px;letter-spacing:-3px}

  /* ---------- Remate ---------- */
  #s4{
    background:radial-gradient(130% 80% at 50% -10%, #4a1f9e 0%, #221545 45%, #0e0c16 100%);
    color:#fff;
    box-shadow:0 24px 70px rgba(80,30,220,.35), 0 24px 60px rgba(0,0,0,.6);
  }
  #s4 .body{padding:24px 18px 24px}
  #s4 h2{color:#fff;font-size:26px;font-style:italic;letter-spacing:-.8px;margin-bottom:8px}
  #s4 .desc{color:#b6adcf;margin-bottom:14px}
  .reveal{text-align:center}

  .halo{position:relative;width:130px;height:112px;margin:0 auto 2px;display:flex;align-items:center;justify-content:center}
  .halo::before{
    content:"";position:absolute;width:130px;height:130px;border-radius:50%;
    background:radial-gradient(circle,rgba(124,77,255,.55) 0%,rgba(124,77,255,0) 68%);
    animation:pulse 2.4s ease-in-out infinite;
  }
  .reveal .face{position:relative;font-size:70px;line-height:1;filter:drop-shadow(0 8px 18px rgba(0,0,0,.5))}
  @keyframes pulse{0%,100%{transform:scale(.9);opacity:.75}50%{transform:scale(1.15);opacity:1}}

  /* marcador: el número se desangra de 1.000 a 0 */
  .scoreboard{
    position:relative;overflow:hidden;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.12);
    border-radius:18px;padding:16px 14px 14px;margin:2px 0 14px;
  }
  .scoreboard::after{
    content:"";position:absolute;top:0;bottom:0;width:60%;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.13),transparent);
    animation:sweep 2.8s ease-in-out infinite;
  }
  @keyframes sweep{0%{left:-70%}60%,100%{left:120%}}
  .bigcount{
    font-size:62px;font-weight:900;line-height:1;letter-spacing:-3px;
    background:linear-gradient(180deg,#ffe58a,#ffab1f);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:0 6px 22px rgba(255,171,31,.25);
  }
  .bigcount.dead{
    background:linear-gradient(180deg,#ff9b9b,#e03131);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:none;animation:shake .5s cubic-bezier(.36,.07,.19,.97) both;
  }
  @keyframes shake{
    10%,90%{transform:translateX(-2px)}20%,80%{transform:translateX(4px)}
    30%,50%,70%{transform:translateX(-7px)}40%,60%{transform:translateX(7px)}
  }
  .countlbl{
    margin-top:9px;font-size:10.5px;font-weight:800;letter-spacing:4px;
    text-transform:uppercase;color:#8f86ac;
  }

  .sign{
    background:rgba(255,255,255,.06);border:1px dashed rgba(255,255,255,.22);
    border-radius:14px;padding:14px;font-size:14.5px;font-weight:700;
    color:#c6bee0;line-height:1.5;margin:0 0 16px;
  }
  .sign b{color:#fff}

  /* entrada escalonada */
  .rise{opacity:0}
  #s4.play .rise{animation:rise .55s cubic-bezier(.2,.8,.3,1) both}
  #s4.play .face{animation:pop .65s cubic-bezier(.2,1.7,.4,1) both}
  @keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  @keyframes pop{0%{transform:scale(.3) rotate(-18deg);opacity:0}70%{transform:scale(1.12) rotate(6deg)}100%{transform:none;opacity:1}}

  /* ---------- Bloque del enlace ---------- */
  .linkbox{
    position:relative;text-align:left;
    background:linear-gradient(160deg,rgba(124,77,255,.22),rgba(26,86,219,.14));
    border:1px solid rgba(168,132,255,.5);border-radius:16px;
    padding:15px;margin:0 0 16px;
    animation:glow 2.6s ease-in-out infinite;
  }
  @keyframes glow{
    0%,100%{box-shadow:0 0 0 0 rgba(124,77,255,.45)}
    50%{box-shadow:0 0 26px 2px rgba(124,77,255,.45)}
  }
  .linkbox .lb-title{
    font-size:16px;font-weight:900;color:#fff;margin:0 0 4px;letter-spacing:-.3px;
  }
  .linkbox .lb-help{font-size:13px;font-weight:700;color:#cfc2ff;line-height:1.45;margin:0 0 10px}
  .linkurl{
    display:block;width:100%;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:11.5px;line-height:1.5;color:#ece7ff;
    background:rgba(0,0,0,.42);border:1px dashed rgba(168,132,255,.55);border-radius:10px;
    padding:10px;word-break:break-all;user-select:all;-webkit-user-select:all;
  }
  .btn-glow{
    background:linear-gradient(90deg,#7c4dff,#1a56db);
    box-shadow:0 5px 0 #2b1580;margin-top:10px;font-size:16px;
  }
  #s4 .btn-ghost{background:rgba(255,255,255,.1);color:#fff;box-shadow:0 5px 0 rgba(255,255,255,.07)}

  /* ---------- Checkout ---------- */
  #s35 .co{padding:18px 16px 18px}
  .co-head{display:grid;grid-template-columns:36px 1fr 36px;align-items:center;margin-bottom:10px}
  .co-back{
    width:36px;height:36px;border:0;background:transparent;padding:0;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
  }
  .co-title{font-size:27px;font-weight:900;letter-spacing:-.9px;text-align:center;margin:0}

  .co-row{display:flex;align-items:center;gap:13px;padding:14px 0}
  .co-row + .co-row{border-top:1px solid var(--line)}
  .co-thumb{
    width:76px;height:76px;flex:0 0 76px;border-radius:16px;
    object-fit:cover;background:#eef0f3;display:block;
  }
  .co-info{flex:1;min-width:0}
  .co-info b{display:block;font-size:17.5px;font-weight:900;letter-spacing:-.4px;line-height:1.2}
  .co-info .sub{display:block;font-size:13px;font-weight:600;color:var(--ink-dim);margin:3px 0 7px}
  .co-free{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:900;color:var(--green)}
  .co-x{
    width:38px;height:38px;flex:0 0 38px;border:0;border-radius:50%;
    background:#eceef1;color:#4b5157;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
  }
  .co-thumb.wide{width:92px;flex:0 0 92px}
  .co-prem{
    display:flex;align-items:center;gap:11px;
    border:1px solid var(--line);border-radius:14px;padding:12px 13px;margin-top:14px;
  }
  .co-prem span{flex:1;font-size:13.5px;font-weight:700;line-height:1.35}
  .co-sub{
    border:0;background:transparent;padding:0;cursor:pointer;white-space:nowrap;
    display:flex;align-items:center;gap:3px;
    font-family:inherit;font-size:13.5px;font-weight:800;color:#0b5cd5;
  }
  .co-total{
    display:flex;align-items:center;justify-content:space-between;
    border-top:1px solid var(--line);padding:16px 0 16px;
    font-size:18.5px;font-weight:900;letter-spacing:-.4px;
  }
  .co-total .val{display:flex;align-items:center;gap:9px;color:var(--green)}
  #claim{font-size:19px;padding:18px;letter-spacing:-.3px}
  .co-safe{
    display:flex;align-items:center;justify-content:center;gap:8px;
    margin-top:15px;font-size:14.5px;font-weight:800;color:var(--ink);
  }
  .co-note{
    text-align:center;font-size:13px;font-weight:600;color:var(--ink-dim);
    margin:7px 0 0;line-height:1.45;
  }
  .co-legal{
    display:flex;gap:11px;align-items:flex-start;
    border-top:1px solid var(--line);margin-top:16px;padding-top:14px;
    font-size:11.5px;font-weight:600;color:#7b8189;line-height:1.5;
  }
  .wiggle{animation:wig .38s ease}
  @keyframes wig{25%{transform:translateX(-6px)}50%{transform:translateX(6px)}75%{transform:translateX(-3px)}}

  /* ---------- Pantallita del enlace ---------- */
  .modal{position:fixed;inset:0;z-index:20;display:none;align-items:flex-end;justify-content:center;padding:12px}
  .modal.on{display:flex}
  .veil{position:absolute;inset:0;background:rgba(8,6,16,.74);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
  .sheet{
    position:relative;width:100%;max-width:420px;
    background:linear-gradient(170deg,#2d1c5e 0%,#171023 100%);
    border:1px solid rgba(168,132,255,.45);border-radius:22px;
    padding:20px 18px calc(18px + env(safe-area-inset-bottom));
    color:#fff;box-shadow:0 -12px 60px rgba(90,40,220,.45);
    animation:up .34s cubic-bezier(.2,.9,.3,1) both;
  }
  @keyframes up{from{transform:translateY(46px);opacity:0}to{transform:none;opacity:1}}
  .sheet .close{
    position:absolute;top:13px;right:13px;width:34px;height:34px;
    border:0;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
  }
  .sheet .step{
    font-size:10.5px;font-weight:800;letter-spacing:3px;text-transform:uppercase;
    color:#bda6ff;margin:0 0 6px;
  }
  .sheet h3{font-size:22px;font-weight:900;letter-spacing:-.6px;margin:0 0 8px;padding-right:34px}
  .sheet .txt{font-size:14px;font-weight:600;color:#c6bce4;line-height:1.5;margin:0 0 14px}
  .steps{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:9px}
  .steps li{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;color:#efeaff}
  .steps b{
    flex:0 0 24px;width:24px;height:24px;border-radius:50%;
    background:rgba(124,77,255,.35);border:1px solid rgba(168,132,255,.6);
    display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:900;
  }
  .okdot{
    display:inline-flex;align-items:center;justify-content:center;
    width:16px;height:16px;border-radius:50%;background:#00a35f;color:#fff;
    font-size:10px;margin-right:5px;vertical-align:-3px;
  }
  .kbd{
    display:inline-block;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);
    border-radius:6px;padding:1px 7px;font-size:13px;font-weight:800;
  }
  .gmock{
    margin:14px 0 12px;padding:0;
    border-radius:16px;overflow:hidden;
    border:1px solid rgba(168,132,255,.35);background:#111;
  }
  .gmock img{display:block;width:100%;height:auto}
  .gmock figcaption{
    background:rgba(255,255,255,.06);
    padding:9px 12px;font-size:12px;font-weight:700;color:#cfc2ff;line-height:1.35;text-align:center;
  }
  .gmock figcaption b{color:#fff}
  .warn{font-size:12.5px;font-weight:600;color:#a99fc9;line-height:1.45;margin:0 0 10px;text-align:center}

  .foot{
    text-align:center;color:#7b8189;font-size:11.5px;font-weight:600;
    margin-top:14px;line-height:1.5;
  }

  .confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:9}
  .conf{position:absolute;width:10px;height:16px;border-radius:2px;top:-30px}

  @media (prefers-reduced-motion:reduce){
    *{animation:none !important;transition:none !important}
    .rise,.reveal .face{opacity:1 !important}
  }
</style>
</head>
<body>
<div class="shell">

  <!-- ====== 1. EVENTO ====== -->
  <section class="stage on card" id="s1">
    <div class="body inv">
      <div class="inv-head">
        <h1>Seu Inventário</h1>
        <button class="inv-filter" id="invFilter" type="button">
          All
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#5e6167" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
      <p class="inv-sub">Itens exclusivos já adicionados à sua conta do evento.</p>

      <div class="grid">
        <figure class="item" role="button" tabindex="0" data-name="Chifres Flamejantes do Submundo" onclick="selectItem(this)"><span class="tick">✓</span>
          <img src="data:image/png;base64," alt="Chifres Flamejantes do Submundo">
          <figcaption>Chifres Flamejantes do Submundo</figcaption>
          <div class="price"><svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M5.6 1.9 22.1 6.3 17.7 22.8 1.2 18.4Z" fill="#5e6167"/><path d="M9.6 9.1l4.9 1.3-1.3 4.9-4.9-1.3z" fill="#fff"/></svg>GRÁTIS</div>
        </figure>
        <figure class="item" role="button" tabindex="0" data-name="Chapéu de Negócios Perfeitamente Legítimo" onclick="selectItem(this)"><span class="tick">✓</span>
          <img src="data:image/png;base64," alt="Chapéu de Negócios Perfeitamente Legítimo">
          <figcaption>Chapéu de Negócios Perfeitamente Legítimo</figcaption>
          <div class="price"><svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M5.6 1.9 22.1 6.3 17.7 22.8 1.2 18.4Z" fill="#5e6167"/><path d="M9.6 9.1l4.9 1.3-1.3 4.9-4.9-1.3z" fill="#fff"/></svg>GRÁTIS</div>
        </figure>
        <figure class="item" role="button" tabindex="0" data-name="Coroa Real 8-Bit" onclick="selectItem(this)"><span class="tick">✓</span>
          <img src="data:image/png;base64," alt="Coroa Real 8-Bit">
          <figcaption>Coroa Real 8-Bit</figcaption>
          <div class="price"><svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M5.6 1.9 22.1 6.3 17.7 22.8 1.2 18.4Z" fill="#5e6167"/><path d="M9.6 9.1l4.9 1.3-1.3 4.9-4.9-1.3z" fill="#fff"/></svg>GRÁTIS</div>
        </figure>
        <figure class="item" role="button" tabindex="0" data-name="Galhos de Ferro Negro" onclick="selectItem(this)"><span class="tick">✓</span>
          <img src="data:image/png;base64," alt="Galhos de Ferro Negro">
          <figcaption>Galhos de Ferro Negro</figcaption>
          <div class="price"><svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M5.6 1.9 22.1 6.3 17.7 22.8 1.2 18.4Z" fill="#5e6167"/><path d="M9.6 9.1l4.9 1.3-1.3 4.9-4.9-1.3z" fill="#fff"/></svg>GRÁTIS</div>
