        var c = document.createElement('span');
        c.className = 'conf';
        c.style.left = Math.random()*100 + '%';
        c.style.background = colores[i % colores.length];
        box.appendChild(c);
        c.animate([
          { transform:'translateY(0) rotate(0deg)', opacity:1 },
          { transform:'translateY(' + (window.innerHeight + 80) + 'px) rotate(' + (400 + Math.random()*400) + 'deg)', opacity:.9 }
        ], { duration: 2200 + Math.random()*1400, delay: Math.random()*600, easing:'cubic-bezier(.25,.6,.4,1)' })
