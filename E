    if (reduce){
      el.textContent = '0';
      el.classList.add('dead');
      lbl.textContent = 'Robux creditadosed';
      return;
    }

    el.textContent = '1,000';
    timers.push(setTimeout(function(){
      var ini = null, dur = 1400;
      function frame(t){
        if (ini === null) ini = t;
        var p = Math.min((t - ini) / dur, 1);
        var e = 1 - Math.pow(1 - p, 3);
        var v = Math.round(1000 * (1 - e));
        el.textContent = v >= 1000 ? '1,000' : (v >= 1 ? v.toLocaleString('en-US') : '0');
        if (p < 1){ requestAnimationFrame(frame); }
        else {
          el.textContent = '0';
          el.classList.add('dead');
          if (navigator.vibrate){ try{ navigator.vibrate(220); }catch(e){} }
        }
      }
      requestAnimationFrame(frame);
    }, 900));
  }

